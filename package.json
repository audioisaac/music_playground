{
  "name": "music-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Play synth chords with two-handed camera gestures.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^7.3.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.104.0"
  }
}
